{
  "schema_id": "neo.voice_engine.manifest.v1",
  "manifest_id": "neo.voice_engine.qwen3_tts",
  "manifest_version": "0.4.4",
  "enabled": true,
  "engine": {
    "id": "qwen3_tts",
    "label": "Qwen3-TTS",
    "description": "Neo Studio managed Qwen3-TTS worker with explicit local model registry/install probes, Phase 4 CustomVoice UI activation, resident-reuse protection, and calibrated 12 GB-class admission for physically validated 1.7B CustomVoice.",
    "worker": {
      "mode": "managed_process",
      "base_url": "http://127.0.0.1:8792",
      "health_path": "/api/voice/health",
      "command": [
        "{python}",
        "-m",
        "uvicorn",
        "neo_integrations.qwen3_tts_adapter.app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8792",
        "--no-access-log",
        "--log-level",
        "warning"
      ],
      "cwd": "",
      "env": {
        "NEO_QWEN3_TTS_NEO_ROOT": "{project_root}",
        "NEO_QWEN3_TTS_HOST": "127.0.0.1",
        "NEO_QWEN3_TTS_PORT": "8792",
        "NEO_VOICE_RUNTIME_ROOT": "{voice_runtime_root}",
        "NEO_QWEN3_TTS_MODEL_ROOT": "{voice_runtime_root}/models/qwen3_tts",
        "NEO_QWEN3_TTS_LOCAL_ONLY": "1"
      },
      "auto_start": false,
      "startup_policy": "on_demand",
      "startup_timeout_seconds": 90,
      "environment": {
        "kind": "venv",
        "scope": "voice_runtime",
        "root": "envs/qwen3_tts",
        "python": "envs/qwen3_tts/Scripts/python.exe"
      },
      "installation": {
        "strategy": "managed",
        "required_paths": [
          "neo_integrations/qwen3_tts_adapter/app.py",
          "neo_integrations/qwen3_tts_adapter/engine.py"
        ],
        "optional_paths": [],
        "expected_size_mb": null,
        "probe_id": "qwen3_tts_runtime_env"
      }
    }
  },
  "models": [
    {
      "id": "qwen3_tts_17b_custom_voice",
      "label": "Qwen3-TTS 1.7B CustomVoice",
      "description": "Built-in-speaker multilingual TTS with natural-language Voice Instruction control. Phase 4.4 admits the physically validated 1.7B route on 12 GB-class CUDA GPUs using separate total-capacity and cold-load-free-VRAM checks.",
      "default": false,
      "tasks": [
        "tts"
      ],
      "languages": [
        "zh",
        "en",
        "ja",
        "ko",
        "de",
        "fr",
        "ru",
        "pt",
        "es",
        "it"
      ],
      "voice_modes": [
        "built_in"
      ],
      "output_formats": [
        "wav"
      ],
      "streaming": false,
      "reference_audio": false,
      "hardware": {
        "cpu": true,
        "cuda": true,
        "rocm": false,
        "mps": false,
        "directml": false,
        "xpu": false,
        "min_vram_mb": 6144,
        "recommended_vram_mb": 6144,
        "min_ram_mb": 24576,
        "gpu_exclusive": true,
        "allow_cpu_fallback": false,
        "min_total_vram_mb": 12000,
        "cold_load_free_vram_mb": 6144,
        "recommended_total_vram_mb": 16384
      },
      "license": {
        "name": "Apache-2.0",
        "spdx_id": "Apache-2.0",
        "commercial_use": "yes",
