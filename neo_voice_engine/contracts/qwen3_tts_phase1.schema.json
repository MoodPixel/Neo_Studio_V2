{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neo.voice_engine.qwen3_tts.contract.schema.v1",
  "title": "Neo Voice Engine Qwen3-TTS Phase 1 Contract",
  "type": "object",
  "required": [
    "schema_id",
    "schema_version",
    "phase",
    "behavioral_activation",
    "source_snapshot",
    "engine_contract",
    "languages",
    "built_in_speakers",
    "models",
    "provider_control_candidates",
    "neo_integration_audit",
    "non_goals"
  ],
  "properties": {
    "schema_id": {"const": "neo.voice_engine.qwen3_tts.contract.v1"},
    "schema_version": {"const": 1},
    "phase": {"const": "qwen3_tts_capability_runtime_contract_audit"},
    "behavioral_activation": {"const": false},
    "audited_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source_snapshot": {
      "type": "object",
      "required": ["github_repository", "github_revision", "package_name", "package_version", "code_license", "python_requires", "pinned_runtime_dependencies"],
      "properties": {
        "github_repository": {"const": "QwenLM/Qwen3-TTS"},
        "github_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_name": {"const": "qwen-tts"},
        "package_version": {"type": "string", "minLength": 1},
        "code_license": {"type": "string", "minLength": 1},
        "python_requires": {"type": "string", "minLength": 1},
        "pinned_runtime_dependencies": {
          "type": "object",
          "required": ["transformers", "accelerate"],
          "properties": {
            "transformers": {"type": "string"},
            "accelerate": {"type": "string"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "engine_contract": {
      "type": "object",
      "required": ["candidate_engine_id", "environment_scope", "behavioral_activation"],
      "properties": {
        "candidate_engine_id": {"const": "qwen3_tts"},
        "environment_scope": {"const": "voice_runtime"},
        "behavioral_activation": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "languages": {
      "type": "object",
      "required": ["neo_codes", "upstream_names", "discovery_policy"],
      "properties": {
        "neo_codes": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "upstream_names": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
        "discovery_policy": {"type": "string"}
      },
      "additionalProperties": true
    },
    "built_in_speakers": {
      "type": "object",
      "required": ["discovery_policy", "audit_seed_only", "items"],
      "properties": {
        "audit_seed_only": {"const": true},
        "items": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["neo_id", "provider_name", "native_language"],
            "properties": {
              "neo_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
              "provider_name": {"type": "string", "minLength": 1},
              "native_language": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "models": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "neo_model_id",
          "upstream_model_id",
          "role",
          "size_class",
          "neo_tasks_target",
          "voice_modes_target",
          "reference_audio",
          "instruction_control",
          "upstream_streaming",
          "initial_neo_streaming",
          "upstream_generation_api",
          "weights_license",
          "hardware_validation"
        ],
        "properties": {
          "neo_model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "upstream_model_id": {"type": "string", "pattern": "^Qwen/Qwen3-TTS-12Hz-"},
          "role": {"enum": ["custom_voice", "base_clone", "voice_design"]},
          "size_class": {"enum": ["0.6B", "1.7B"]},
          "neo_tasks_target": {"type": "array", "minItems": 1, "items": {"enum": ["tts", "voice_clone", "voice_design"]}},
          "voice_modes_target": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "reference_audio": {"type": "boolean"},
          "built_in_speakers": {"type": "boolean"},
          "voice_design": {"type": "boolean"},
          "instruction_control": {"type": "object", "required": ["state"], "properties": {"state": {"type": "string"}}, "additionalProperties": true},
          "upstream_streaming": {"const": true},
          "initial_neo_streaming": {"const": false},
          "upstream_generation_api": {"enum": ["generate_custom_voice", "generate_voice_clone", "generate_voice_design"]},
          "approx_repo_size_mb": {"type": "integer", "minimum": 1},
          "weights_license": {"const": "Apache-2.0"},
          "clone_contract": {"type": "object"},
          "hardware_validation": {
            "type": "object",
            "required": ["min_vram_mb", "recommended_vram_mb", "rtx_12gb_status"],
            "properties": {
              "min_vram_mb": {"type": ["integer", "null"]},
              "recommended_vram_mb": {"type": ["integer", "null"]},
              "rtx_12gb_status": {"const": "pending_physical_validation"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "provider_control_candidates": {"type": "object"},
    "neo_integration_audit": {
      "type": "object",
      "required": ["manifest_v1_fit", "current_activation_blockers", "existing_neo_assets_to_reuse", "phase2_worker_contract_target"],
      "properties": {
        "manifest_v1_fit": {"type": "object"},
        "current_activation_blockers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "severity", "detail"]}},
        "existing_neo_assets_to_reuse": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "phase2_worker_contract_target": {"type": "object"}
      },
      "additionalProperties": true
    },
    "non_goals": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
