        "detail": "neo_voice_engine.jobs currently accepts only tts and voice_clone modes even though manifest vocabulary reserves voice_design."
      },
      {
        "id": "provider_controls_mode_limit",
        "severity": "required_before_voice_design",
        "detail": "neo_app.voice.provider_controls currently allows only tts and voice_clone modes."
      },
      {
        "id": "static_family_fallback",
        "severity": "required_before_activation",
        "detail": "neo_app.voice.capabilities.normalize_family falls back unknown families to chatterbox_turbo; Qwen IDs must be registered before any UI/runtime activation."
      },
      {
        "id": "neo_voice_engine_alias_scope",
        "severity": "required_before_activation",
        "detail": "RUNTIME_ALIASES currently lists only Chatterbox model families for neo_voice_engine."
      },
      {
        "id": "voice_source_option_gap",
        "severity": "required_before_voice_design",
        "detail": "Current Voice Source options are built_in, saved_profile and reference_clone; voice_design requires a dedicated source/mode surface."
      },
      {
        "id": "hardware_admission_unknown",
        "severity": "physical_validation",
        "detail": "Upstream sources audited here do not establish Neo-safe min/recommended VRAM values; do not invent scheduler thresholds before physical tests."
      }
    ],
