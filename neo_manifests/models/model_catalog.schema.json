{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neo-studio.local/schemas/model_catalog.v1.json",
  "title": "Neo Studio Model Catalog Manifest",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "catalog",
    "records"
  ],
  "properties": {
    "schema_id": {
      "const": "neo.models.catalog.v1"
    },
    "version": {
      "type": "string"
    },
    "catalog": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "status",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "policy": {
          "type": "string"
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "category",
          "base_model",
          "model_type",
          "source_mode",
          "source",
          "install",
          "ui"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "image",
              "video",
              "llm",
              "utility",
              "voice"
            ]
          },
          "base_model": {
            "type": "string"
          },
          "model_type": {
            "type": "string"
          },
          "source_mode": {
            "enum": [
              "static_file",
              "discover_files",
              "manual_only",
              "repository_snapshot"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "provider": {
                "enum": [
                  "huggingface",
                  "civitai",
                  "manual",
                  "local",
                  "url"
                ]
              },
              "repo": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "source_url": {
                "type": "string"
              },
              "download_url": {
                "type": "string"
              },
              "requires_token": {
                "type": "boolean"
              },
              "gated": {
                "type": "boolean"
              },
              "private": {
                "type": "boolean"
              },
              "discovery": {
                "type": "boolean"
              },
              "hashes": {
                "type": "object",
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                  }
                }
              }
            }
          },
          "file_rules": {
            "type": "object"
          },
          "install": {
            "type": "object",
            "properties": {
              "strategy": {
                "type": "string"
              },
              "target_type": {
                "type": "string"
              },
              "backend_targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "probe_id": {
                "type": "string"
              },
              "expected_size_mb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "path_rule": {
                "type": "string"
              },
              "allow_patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "ignore_patterns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "ui": {
            "type": "object"
          },
          "hardware": {
            "type": "object"
          },
          "license": {
            "type": "object"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact": {
            "type": "object",
            "required": [
              "schema_id",
              "family_id",
              "architecture",
              "variant",
              "format",
              "precision",
              "tasks",
              "runtime",
              "io",
              "provenance"
            ],
            "properties": {
              "schema_id": {
                "const": "neo.models.artifact.v1"
              },
              "family_id": {
                "type": "string",
                "minLength": 1
              },
              "architecture": {
                "type": "string",
                "minLength": 1
              },
              "variant": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "minLength": 1
              },
              "precision": {
                "type": "string",
                "minLength": 1
              },
              "tasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "runtime": {
                "type": "object",
                "required": [
                  "id",
                  "providers",
                  "platforms",
                  "platform_validation",
                  "node_inputs"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "providers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "platforms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "platform_validation": {
                    "const": "not_tested"
                  },
                  "node_inputs": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              },
              "io": {
                "type": "object",
                "required": [
                  "input",
                  "output",
                  "native_scale",
                  "sizing_policy",
                  "size_constraints",
                  "tiling"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "output": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size_constraints": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tiling": {
                    "type": "string",
                    "minLength": 1
                  },
                  "native_scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 16
                  },
                  "sizing_policy": {
                    "const": "user_target"
                  }
                }
              },
              "provenance": {
                "type": "object",
                "required": [
                  "upstream_url",
                  "revision_kind",
                  "checksum_state",
                  "reviewed_at"
                ],
                "properties": {
                  "upstream_url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision_kind": {
                    "enum": [
                      "commit",
                      "release_tag",
                      "unresolved"
                    ]
                  },
                  "checksum_state": {
                    "enum": [
                      "published",
                      "not_published",
                      "unresolved"
                    ]
                  },
                  "reviewed_at": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_mode": {
                  "const": "repository_snapshot"
                }
              },
              "required": [
                "source_mode"
              ]
            },
            "then": {
              "properties": {
                "source": {
                  "type": "object",
                  "required": [
                    "provider",
                    "repo",
                    "revision"
                  ],
                  "properties": {
                    "provider": {
                      "const": "huggingface"
                    },
                    "repo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "install": {
                  "type": "object",
                  "required": [
                    "strategy",
                    "target_type",
                    "backend_targets",
                    "probe_id",
                    "expected_size_mb"
                  ],
                  "properties": {
                    "strategy": {
                      "const": "huggingface_snapshot"
                    },
                    "target_type": {
                      "const": "hf_cache"
                    },
                    "backend_targets": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "probe_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expected_size_mb": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "allow_patterns": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    },
                    "ignore_patterns": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "uniqueItems": true
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
