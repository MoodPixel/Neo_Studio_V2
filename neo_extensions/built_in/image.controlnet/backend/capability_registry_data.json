    "composition_silhouette": {
      "label": "Composition / Silhouette",
      "default_preprocessor": "none",
      "preprocessors": [
        "none"
      ],
      "model_bindings": {
        "krea2_control_plus": {
          "selection_kind": "control_lora",
          "selector_label": "Control LoRA",
          "catalog_source": "krea2_control_plus.lora_models",
          "catalog_kind": "krea2_control_plus_lora_live_enum",
          "compatibility_mode": "filename_tokens",
          "strict": true,
          "required_all_tokens": [
            "krea2"
          ],
          "required_any_tokens": [
            "anythng",
            "silhouette",
            "composition"
          ],
          "exclude_tokens": [
            "depth",
            "canny",
            "openpose",
            "pose",
            "lineart",
            "normal",
            "normalbae",
            "nk2e"
          ],
          "empty_policy": "show_intent_with_no_compatible_models",
          "notes": [
            "Krea2 Control Plus reads the shared models/loras catalog. Neo exposes only composition/silhouette-like Krea2 LoRAs for this intent; the public krea2-anythng checkpoint matches this contract."
          ]
        }
      }
    }
  },
