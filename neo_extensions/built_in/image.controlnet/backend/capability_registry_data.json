{
  "schema_id": "neo.image.controlnet.capability_registry.v1",
  "schema_version": 1,
  "extension_id": "image.controlnet",
  "phase": "Phase 6 — Krea 2 RAW Canny via NK2E",
  "behavioral_activation": true,
  "source_of_truth": {
    "product_policy": "Only implemented family/route control intents may become normal UI choices. Krea 2 RAW routes Depth through native Krea Control, Composition / Silhouette through Krea2 Control Plus, and Canny through the NK2E in-context adapter. Krea 2 Turbo keeps Depth, Composition / Silhouette, and OpenPose through Ostris. Each intent owns its compatible live LoRA catalog and route-specific settings.",
    "audit_inputs": [
      "backend/route_profiles.py",
      "backend/workflow_patch.py",
      "backend/map_preprocessors.py",
      "backend/node_discovery.py",
      "ui/panel.html",
      "ui/panel.js",
      "neo_app/static/js/neo.js",
      "extension_manifest.json",
      "backend/capability_registry.py",
      "backend/validation.py"
    ]
  },
  "states": {
    "implemented": "Neo owns an executable adapter for the intent on at least one declared route. Runtime node/model discovery may still gate a specific backend.",
    "planned": "Architecture target is known but the Neo execution adapter is not active. Never expose in normal UI.",
    "unsupported": "No current Neo product route. Never expose in normal UI."
  },
  "intents": {
    "canny": {
      "label": "Canny",
      "default_preprocessor": "canny",
      "preprocessors": [
        "canny",
        "none"
      ],
      "model_bindings": {
        "krea2_nk2e_canny": {
          "selection_kind": "control_lora",
          "selector_label": "Control LoRA",
          "catalog_source": "krea2_nk2e.lora_models",
          "catalog_kind": "krea2_nk2e_canny_lora_live_enum",
          "compatibility_mode": "filename_tokens",
          "strict": true,
          "required_all_tokens": [
            "nk2e",
            "canny"
          ],
          "required_any_tokens": [],
          "exclude_tokens": [
            "depth",
            "openpose",
            "pose",
            "lineart",
            "normal",
            "normalbae",
            "composition",
            "silhouette",
            "anythng"
          ],
          "empty_policy": "hide_intent_when_runtime_catalog_checked_and_no_compatible_models",
          "notes": [
            "Phase 6 binds Krea 2 RAW Canny to the live LoraLoaderModelOnly catalog used by ComfyUI-NK2E. The published ComfyUI checkpoint is NK2E-canny-v0.1.safetensors."
          ]
        }
      }
    },
    "depth": {
      "label": "Depth",
      "default_preprocessor": "depth",
      "preprocessors": [
        "depth",
        "none"
      ],
      "model_bindings": {
        "krea2_native_control_lora": {
          "selection_kind": "control_lora",
          "selector_label": "Control LoRA",
          "catalog_source": "krea2_control.lora_models",
          "catalog_kind": "krea2_control_lora_live_enum",
          "compatibility_mode": "filename_tokens",
          "strict": true,
          "required_all_tokens": [
            "depth"
          ],
          "required_any_tokens": [
            "control",
            "controlnet"
          ],
          "exclude_tokens": [
            "canny",
            "openpose",
            "pose",
            "lineart",
            "normal",
            "normalbae",
            "composition",
            "silhouette",
            "anythng",
            "nk2e"
          ],
          "empty_policy": "show_intent_with_no_compatible_models",
          "notes": [
            "Krea2ControlLoRALoader publishes every LoRA in models/loras. Neo therefore filters the shared catalog and only exposes depth-control-like names for the currently implemented Krea Depth intent."
          ]
        }
      }
    },
    "openpose": {
      "label": "Pose",
      "default_preprocessor": "openpose",
      "preprocessors": [
        "openpose",
        "dwpose",
        "none"
      ],
      "model_bindings": {
        "krea2_ostris_openpose": {
          "selection_kind": "control_lora",
          "selector_label": "Control LoRA",
          "catalog_source": "krea2_ostris.lora_models",
          "catalog_kind": "krea2_ostris_pose_lora_live_enum",
          "compatibility_mode": "filename_tokens",
          "strict": true,
          "required_all_tokens": [
            "krea2",
            "openpose"
          ],
          "required_any_tokens": [
            "control",
            "controlnet"
          ],
          "exclude_tokens": [
            "depth",
            "canny",
            "lineart",
            "normal",
            "normalbae",
            "composition",
            "silhouette",
            "anythng",
            "nk2e"
          ],
          "empty_policy": "hide_intent_when_runtime_catalog_checked_and_no_compatible_models",
          "notes": [
            "Phase 5 binds Krea 2 Turbo OpenPose to the live LoraLoaderModelOnly catalog used by the Ostris edit workflow."
          ]
        }
      }
    },
    "lineart": {
      "label": "Lineart",
      "default_preprocessor": "lineart",
      "preprocessors": [
        "lineart",
