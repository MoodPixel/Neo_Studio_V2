    "selector_source": "backend_capability_registry",
    "stale_selection_policy": "sanitize_to_first_implemented_intent_or_empty",
    "submit_policy": "fail_closed_on_unimplemented_intent",
    "model_selector_source": "resolved_intent_binding",
    "shared_lora_catalog_policy": "strict_filter_before_control_selector",
    "stale_model_policy": "clear_when_runtime_catalog_is_checked_and_selection_is_incompatible",
    "type_change_model_policy": "clear_model_selection_and_require_rebind",
    "normal_lora_stack_independent": true,
    "submit_model_policy": "fail_closed_on_strict_intent_binding_mismatch"
  },
  "audit_findings": [
    {
      "id": "krea_legacy_broad_list",
      "severity": "important",
      "finding": "Krea UI currently narrows the generic list to canny/depth/openpose/lineart/normalbae and route profiles declare the same broad set, but only Depth is current Neo product capability under the Phase 0 policy.",
      "resolution": "Registry truth is Depth implemented; Composition/OpenPose/Canny planned; all other Krea intents hidden/unsupported until dedicated adapters ship."
    },
    {
      "id": "flux2_mlsd_gray_declaration_gap",
      "severity": "important",
      "finding": "Flux2/Klein route profiles list mlsd and gray, while the current ControlNet Type UI and map preprocessor contract do not expose/implement those intents.",
      "resolution": "Registry excludes mlsd and gray from implemented intents."
    },
    {
      "id": "qwen2511_special_lane",
      "severity": "important",
      "finding": "Qwen Image Edit 2511 Pose Transfer is implemented in workflow_patch.py but does not belong to the standard route-profile ControlNet family matrix.",
      "resolution": "Registry records OpenPose/Pose Transfer as a dedicated experimental capability with qwen_transfer method."
    },
    {
      "id": "sdxl_outpaint_task_split",
      "severity": "important",
      "finding": "SDXL map_control+outpaint is not promoted, while outpaint_control uses a dedicated SD mask/canvas adapter and is available.",
      "resolution": "Registry keeps task capability separate from map intent visibility."
    },
    {
      "id": "preprocessor_not_capability",
      "severity": "policy",
      "finding": "Map preprocessors are intentionally architecture-independent and can exist for types a model family cannot execute.",
      "resolution": "Registry capability is family/route/adapter-owned; preprocessor availability is only a runtime dependency."
    },
    {
      "id": "krea_shared_lora_catalog_leak",
      "severity": "important",
      "finding": "Krea2ControlLoRALoader exposes the full models/loras enum, so ordinary style/character LoRAs and control LoRAs for other Krea workflows can appear beside the validated Depth Control LoRA unless Neo applies an intent binding.",
      "resolution": "Phase 3 binds Krea Depth to the krea2_native_control_lora adapter and filters the live shared LoRA enum by a strict depth-control filename token contract before UI exposure and submit/workflow validation."
    },
    {
      "id": "phase4_krea2_composition_control_plus",
      "finding": "Krea 2 Composition / Silhouette is now an implemented intent with an intent-specific Krea2 Control Plus adapter. Runtime visibility is gated by the Plus node trio and compatible shared-LoRA catalog."
    },
    {
      "id": "phase5_krea2_turbo_openpose_ostris",
      "severity": "info",
      "finding": "Krea 2 Turbo OpenPose is implemented only through the Ostris edit adapter and remains hidden for Krea 2 RAW until a RAW-compatible pose LoRA is verified."
    }
  ]
}
