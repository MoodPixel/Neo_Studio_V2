      "sd28_7_compile_time_support_must_not_claim_gpu_spatial_proof",
      "krea2_external_builder_apply_required",
      "krea2_neoregionalloradelta_fallback_forbidden",
      "krea2_regional_lora_rows_must_not_global_load",
      "krea2_external_runtime_fail_closed_when_missing"
