{
  "schema": "neo.image.sampling_guidance_capabilities.v1",
  "phase": "IP-1",
  "version": "1.0.0",
  "purpose": "Capability semantics only. This registry does not choose best sampling defaults or decide route availability.",
  "global_contract": {
    "route_availability_owner": "neo_app.models.route_matrix + provider compile router",
    "preset_defaults_owner": "IP-3 owns preset resolution/application semantics; family numeric defaults are deferred to IP-4/IP-5",
    "negative_prompt_execution_owner": "neo_app.image.negative_prompt_eligibility (IP-2) at the NeoJob Image boundary",
    "unknown_family_policy": "fail_closed_provider_profile",
    "negative_prompt_value_retention": "retain_user_input_when_inactive; effective provider negative becomes empty only when IP-2 suppresses execution",
    "negative_cfg_hard_threshold": 1.0,
    "negative_cfg_weak_threshold": 1.5,
    "threshold_semantics": "For cfg-gated routes, <=1.0 means inactive; >1.0 and <1.5 is technically active but weak; >=1.5 is normal UX state. Family/route overrides win.",
    "negative_prompt_ui_owner": "neo_app/static/js/negative_prompt_eligibility.js (IP-2 mirror; backend remains authoritative)",
    "preset_foundation_owner": "neo_app.image.sampling_presets (IP-3)",
    "preset_clean_slate_policy": "Empty · Clean Slate never borrows provider defaults; incomplete manual sampling blocks generation",
    "preset_provider_defaults_policy": "Provider Defaults intentionally removes preset-managed fields so provider/compiler defaults remain authoritative"
  },
  "resolution_policies": {
    "explicit_canvas": "Text generation owns width/height explicitly.",
    "source_or_auto": "Image-conditioned generation follows source dimensions or provider auto-sizing; family native size is only a fallback later in preset resolution.",
    "expanded_canvas_or_auto": "Outpaint follows expanded source canvas or provider auto-sizing.",
    "provider_profile": "Provider/model profile owns the size contract."
  },
  "denoise_policies": {
    "full_generation": "Text generation is full denoise/generation.",
    "strength_controlled": "Image-conditioned route exposes user/provider denoise strength.",
    "masked_strength_controlled": "Masked route exposes user/provider denoise strength while mask/canvas controls locality.",
    "provider_profile": "Provider/model profile owns denoise semantics."
  },
  "families": {
