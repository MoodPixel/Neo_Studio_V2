{
  "$defs": {
    "SpaceAssetReference": {
      "additionalProperties": false,
      "description": "Portable NCS-4 asset handle.\n\nNCS-4 deliberately knows only the stable identity/kind. NCS-6 owns upload,\nstorage, metadata, and conversion into a Comfy-ready filename/value.",
      "properties": {
        "ref_type": {
          "const": "neo_asset_ref",
          "default": "neo_asset_ref",
          "title": "Ref Type",
          "type": "string"
        },
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "mask",
            "video",
            "audio",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind"
      ],
      "title": "SpaceAssetReference",
      "type": "object"
    },
    "SpaceBindingIssue": {
