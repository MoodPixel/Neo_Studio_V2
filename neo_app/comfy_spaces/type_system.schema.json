          "type": "integer"
        },
        "preview": {
          "items": {},
          "title": "Preview",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "searchable": {
          "default": false,
          "title": "Searchable",
          "type": "boolean"
        }
      },
      "title": "SpaceOptionContract",
      "type": "object"
    },
    "SpaceOutputTypeDescriptor": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "neo.comfy_space.type_system.v1",
          "default": "neo.comfy_space.type_system.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "integer",
            "number",
            "boolean",
            "choice",
            "json",
            "image",
            "mask",
            "video",
            "audio",
            "file"
