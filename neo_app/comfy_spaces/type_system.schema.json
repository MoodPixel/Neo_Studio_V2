          "title": "Accepted Mime Types",
          "type": "array"
        },
        "asset_bus_required": {
          "default": false,
          "title": "Asset Bus Required",
          "type": "boolean"
        },
        "supports_multiple": {
          "default": false,
          "title": "Supports Multiple",
          "type": "boolean"
        },
