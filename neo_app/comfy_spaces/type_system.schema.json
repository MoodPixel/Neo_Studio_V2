          "type": "string"
        },
        "value_shape": {
          "default": "scalar",
          "enum": [
            "scalar",
            "structured",
            "asset_ref"
          ],
          "title": "Value Shape",
          "type": "string"
        },
        "confidence": {
          "default": "exact",
          "enum": [
            "exact",
            "heuristic",
            "fallback"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required"
        },
        "model_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Type"
        },
        "asset_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
