            "scalar",
            "structured",
            "asset_ref"
          ],
          "title": "Value Shape",
          "type": "string"
        },
        "confidence": {
          "default": "exact",
          "enum": [
            "exact",
            "heuristic",
            "fallback"
          ],
          "title": "Confidence",
          "type": "string"
