        "asset_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Kind"
        },
        "previewable": {
          "default": false,
          "title": "Previewable",
          "type": "boolean"
        },
        "downloadable": {
