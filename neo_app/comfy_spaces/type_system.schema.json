{
  "$defs": {
    "SpaceInputTypeDescriptor": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "neo.comfy_space.type_system.v1",
          "default": "neo.comfy_space.type_system.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "integer",
            "number",
            "boolean",
            "choice",
            "json",
            "image",
            "mask",
            "video",
            "audio",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "control": {
          "enum": [
            "text_input",
            "text_area",
            "integer_input",
            "number_input",
            "slider",
            "seed_input",
            "toggle",
            "select",
            "search_select",
            "model_select",
            "json_editor",
            "image_upload",
            "mask_upload",
            "video_upload",
            "audio_upload",
            "file_upload"
